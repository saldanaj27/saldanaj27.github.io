<WorkPage
  title="Authentication Platform"
  oneLiner="The authentication management layer for the FICO Platform: a stateless gRPC facade over the upstream identity provider, with declarative credential provisioning."
  role="Service owner: design, implementation, deployment, on-call"
  timeframe="FICO Platform"
  stack={['Spring Boot', 'gRPC', 'OAuth2/OIDC', 'Kubernetes']}
