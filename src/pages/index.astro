---
import Base from '../layouts/Base.astro';
import MetricStrip from '../components/MetricStrip.astro';

// Work pages and write-ups are temporarily unlinked while their copy is
// revised. See README ("Hidden sections").
const metrics = [
  { value: '1M+', label: 'daily auth requests' },
  { value: '30+', label: 'services consuming' },
  { value: '2h → 8m', label: 'RBAC provisioning' },
];
---

<Base
  title="Javier Saldana · Platform Infrastructure Engineer"
  description="Platform engineer working on identity and authorization infrastructure, with distributed-systems depth."
>
  <p class="label">Lead Software Engineer · New York, NY</p>
  <h1>Javier Saldana</h1>
  <p class="positioning">
    I'm a platform engineer in New York, four years into building the identity
    and authorization layer of the FICO Platform. I work on the services, policy
    engines, and Kubernetes operators that other teams route a million requests
    a day through. Shared infrastructure has a particular kind of stakes. When
    it breaks, it breaks for everyone, and your users are engineers who will
    tell you about it immediately. I enjoy that pressure, because it pushes me
    toward simpler, more efficient solutions.
  </p>

  <MetricStrip metrics={metrics} />

  <p class="more">
    More about how I got here and what I'm looking for on the
    <a href="/about/">about page</a>.
  </p>

  <p class="meta links">
    <a href="/Javier_Saldana_Resume.pdf">Resume (PDF)</a> ·
    <a href="https://github.com/saldanaj27">GitHub</a> ·
    <a href="https://linkedin.com/in/javier-saldana27">LinkedIn</a> ·
    <a href="mailto:saldanaj27@gmail.com">saldanaj27@gmail.com</a>
  </p>

  <style>
    .positioning {
      font-size: 1.3125rem;
      line-height: 1.55;
      margin-top: 1.25rem;
    }
    .more {
      margin-top: 2rem;
    }
    .links {
      margin-top: 2.5rem;
    }
  </style>
</Base>
