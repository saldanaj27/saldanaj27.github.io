<WorkPage
  title="Authorization Platform"
  oneLiner="An OPA-based policy distribution system that makes authorization a sub-millisecond local decision in every service, with no central auth server."
  role="Operator: sole designer · bundle pipeline: contributor · client library: builder"
  timeframe="FICO Platform"
  stack={['OPA', 'Rego', 'Java', 'gRPC', 'Pulsar']}
